{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "trace-search License Manifest",
  "description": "Machine-readable license manifest for all dependencies, models, weights, datasets, and test clips. See PRD Cut 01 §2a and AC-01.",
  "type": "object",
  "required": ["manifest_version", "last_updated_ist", "entries"],
  "properties": {
    "manifest_version": {
      "type": "string",
      "description": "Manifest format version",
      "const": "1.0"
    },
    "last_updated_ist": {
      "type": "string",
      "description": "Last update date in IST (YYYY-MM-DD)",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "entries": {
      "type": "array",
      "description": "List of all dependencies, models, weights, datasets, and clips",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version", "type", "license", "source_url", "sha256"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the component",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "description": "Version string or git commit hash",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["library", "model", "weight", "dataset", "clip", "synthetic_clip", "code_fixture", "generator", "tool"],
            "description": "Type of component"
          },
          "license": {
            "type": "string",
            "description": "License identifier (SPDX preferred) or full license name",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "description": "Source URL (repo, download page, or PyPI)",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 hash of the component"
          },
          "license_version": {
            "type": "string",
            "description": "For clips only: license version or terms last-updated date"
          },
          "date_checked_ist": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "For clips only: date license terms were checked (IST, YYYY-MM-DD)"
          },
          "phash": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{16}$"
            },
            "minItems": 10,
            "maxItems": 10,
            "uniqueItems": true,
            "description": "For clips only: exactly 10 perceptual hashes of sampled frames (hex)"
          },
          "use": {
            "type": "string",
            "enum": ["SMOKE_ONLY", "CODE_TEST"],
            "description": "Usage tag. Stock/synthetic clips are SMOKE_ONLY; FX-CODE fixtures are CODE_TEST."
          },
          "fixture_id": {
            "type": "string",
            "pattern": "^FX-(SMOKE(-SYN)?|CODE)-[0-9]+$",
            "description": "FX-SMOKE-### (clip/SMOKE_ONLY), FX-SMOKE-SYN-### (synthetic_clip/SMOKE_ONLY), FX-CODE-### (code_fixture/CODE_TEST)"
          },
          "generator": {
            "type": "string",
            "minLength": 1,
            "description": "For synthetic clips, FX-CODE rows, and generators: generator name"
          },
          "generator_version": {
            "type": "string",
            "minLength": 1,
            "description": "Generator version or commit"
          },
          "generator_license": {
            "type": "string",
            "description": "For synthetic clips: generator license"
          },
          "seed": {
            "type": "string",
            "minLength": 1,
            "description": "Seed or prompt used to generate the clip or fixture"
          },
          "notes": {
            "type": "string",
            "description": "Optional notes about provenance or special handling"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "type": { "const": "clip" } },
              "required": ["type"]
            },
            "then": {
              "required": ["license_version", "date_checked_ist", "phash", "use", "fixture_id"],
              "properties": {
                "use": { "const": "SMOKE_ONLY" },
                "fixture_id": { "pattern": "^FX-SMOKE-[0-9]+$" }
              }
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "synthetic_clip" } },
              "required": ["type"]
            },
            "then": {
              "required": [
                "license_version",
                "date_checked_ist",
                "phash",
                "use",
                "fixture_id",
                "generator",
                "generator_version",
                "generator_license",
                "seed"
              ],
              "properties": {
                "use": { "const": "SMOKE_ONLY" },
                "fixture_id": { "pattern": "^FX-SMOKE-SYN-[0-9]+$" }
              }
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "code_fixture" } },
              "required": ["type"]
            },
            "then": {
              "required": [
                "use",
                "fixture_id",
                "generator",
                "generator_version",
                "generator_license",
                "seed"
              ],
              "properties": {
                "use": { "const": "CODE_TEST" },
                "fixture_id": { "pattern": "^FX-CODE-[0-9]+$" }
              }
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "generator" } },
              "required": ["type"]
            },
            "then": {
              "required": ["generator_license", "seed"],
              "properties": {
                "generator_license": { "type": "string", "minLength": 1 },
                "seed": { "type": "string", "minLength": 1 }
              }
            }
          },
          {
            "if": {
              "properties": { "fixture_id": { "pattern": "^FX-SMOKE-SYN-[0-9]+$" } },
              "required": ["fixture_id"]
            },
            "then": {
              "properties": {
                "type": { "const": "synthetic_clip" },
                "use": { "const": "SMOKE_ONLY" }
              }
            }
          },
          {
            "if": {
              "properties": { "fixture_id": { "pattern": "^FX-CODE-[0-9]+$" } },
              "required": ["fixture_id"]
            },
            "then": {
              "properties": {
                "type": { "const": "code_fixture" },
                "use": { "const": "CODE_TEST" }
              }
            }
          },
          {
            "if": {
              "properties": { "fixture_id": { "pattern": "^FX-SMOKE-[0-9]+$" } },
              "required": ["fixture_id"]
            },
            "then": {
              "properties": {
                "type": { "const": "clip" },
                "use": { "const": "SMOKE_ONLY" }
              }
            }
          }
        ]
      }
    }
  }
}
