{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "trace-search License Manifest",
  "description": "Machine-readable license manifest for all dependencies, models, weights, datasets, and test clips. See PRD Cut 01 §2a and AC-01.",
  "type": "object",
  "required": ["manifest_version", "last_updated_ist", "entries"],
  "properties": {
    "manifest_version": {
      "type": "string",
      "description": "Manifest format version",
      "const": "1.0"
    },
    "last_updated_ist": {
      "type": "string",
      "description": "Last update date in IST (YYYY-MM-DD)",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "entries": {
      "type": "array",
      "description": "List of all dependencies, models, weights, datasets, and clips",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version", "type", "license", "source_url", "sha256"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the component",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "description": "Version string or git commit hash",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["library", "model", "weight", "dataset", "clip", "synthetic_clip", "generator", "tool"],
            "description": "Type of component"
          },
          "license": {
            "type": "string",
            "description": "License identifier (SPDX preferred) or full license name",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "description": "Source URL (repo, download page, or PyPI)",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 hash of the component"
          },
          "license_version": {
            "type": "string",
            "description": "For clips only: license version or terms last-updated date"
          },
          "date_checked_ist": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "For clips only: date license terms were checked (IST, YYYY-MM-DD)"
          },
          "phash": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{16}$"
            },
            "minItems": 10,
            "maxItems": 10,
            "uniqueItems": true,
            "description": "For clips only: exactly 10 perceptual hashes of sampled frames (hex)"
          },
          "use": {
            "type": "string",
            "enum": ["SMOKE_ONLY", "CODE_TEST", "TRAIN", "DEV", "HOLD"],
            "description": "For clips/fixtures only: usage tag"
          },
          "fixture_id": {
            "type": "string",
            "pattern": "^FX-[A-Z]+-([A-Z]+-)?[0-9]+$",
            "description": "Fixture identifier (e.g., FX-SMOKE-001, FX-SMOKE-SYN-001, FX-DEV-023)"
          },
          "generator": {
            "type": "string",
            "description": "For synthetic clips: generator name"
          },
          "generator_version": {
            "type": "string",
            "description": "For synthetic clips: generator version"
          },
          "generator_license": {
            "type": "string",
            "description": "For synthetic clips: generator license"
          },
          "seed": {
            "type": "string",
            "description": "For synthetic clips: random seed or generation parameters"
          },
          "notes": {
            "type": "string",
            "description": "Optional notes about provenance or special handling"
          }
        },
        "if": {
          "properties": {
            "type": {
              "enum": ["clip", "synthetic_clip"]
            }
          }
        },
        "then": {
          "required": ["license_version", "date_checked_ist", "phash", "use"]
        }
      }
    }
  }
}
